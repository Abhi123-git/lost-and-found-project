<%- include('../partials/header', {title:'Admin dashboard — FindIt'}) %><div class="page-heading"><div><span class="eyebrow">PLATFORM CONTROL</span><h1>Admin dashboard</h1><p>Overview of community activity and account management.</p></div><span class="admin-label">Administrator</span></div><div class="admin-stats"><div><small>REGISTERED USERS</small><strong><%= stats.users %></strong></div><div><small>TOTAL REPORTS</small><strong><%= stats.items %></strong></div><div><small>ACTIVE LOST</small><strong><%= stats.lost %></strong></div><div><small>ACTIVE FOUND</small><strong><%= stats.found %></strong></div><div><small>RETURNED</small><strong><%= stats.returned %></strong></div><div><small>CONTACT REQUESTS</small><strong><%= stats.requests %></strong></div></div><section class="section-block"><div class="section-heading"><div><span class="eyebrow">ACCOUNT MANAGEMENT</span><h2>Registered users</h2></div></div><div class="table-responsive"><table class="table clean-table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th><th>Actions</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><b><%= u.name %></b></td><td><%= u.email %></td><td><span class="status-badge"><%= u.role %></span></td><td><%= u.createdAt.toLocaleDateString('en-IN') %></td><td><% if(u._id.toString()!==currentUser.id){ %><form class="d-inline-flex gap-1" method="POST" action="/admin/users/<%= u._id %>/role"><select name="role" class="form-select form-select-sm"><option value="user" <%= u.role==='user'?'selected':'' %>>User</option><option value="admin" <%= u.role==='admin'?'selected':'' %>>Admin</option></select><button class="btn btn-outline-primary btn-sm">Save</button></form><form class="d-inline" method="POST" action="/admin/users/<%= u._id %>?_method=DELETE" data-confirm="Delete this user and their reports?"><button class="btn btn-outline-danger btn-sm">Delete</button></form><% } else { %><small class="muted">You</small><% } %></td></tr><% }) %></tbody></table></div></section><section class="section-block pt-0"><div class="section-heading"><div><span class="eyebrow">CONTENT MODERATION</span><h2>All item reports</h2></div></div><div class="table-responsive"><table class="table clean-table"><thead><tr><th>Item</th><th>Type</th><th>Owner</th><th>Status</th><th>Manage</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td><a href="/items/<%= item._id %>"><%= item.title %></a></td><td><%= item.type %></td><td><%= item.owner ? item.owner.name : 'Unknown' %></td><td><%= item.status %></td><td><a class="text-link" href="/items/<%= item._id %>/edit">Edit</a> · <form class="d-inline" method="POST" action="/items/<%= item._id %>?_method=DELETE" data-confirm="Delete this report?"><button class="link-button danger-link">Delete</button></form></td></tr><% }) %></tbody></table></div></section><%- include('../partials/footer') %>
