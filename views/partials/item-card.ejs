<article class="item-card h-100"><a class="item-image" href="/items/<%= item._id %>"><% if (item.image) { %><img src="/uploads/<%= item.image %>" alt="<%= item.title %>"><% } else { %><div class="image-placeholder"><span>⌕</span><small>No image provided</small></div><% } %><span class="type-badge <%= item.type %>"><%= item.type === 'lost' ? 'Lost item' : 'Found item' %></span></a><div class="p-3"><div class="d-flex justify-content-between align-items-center mb-2"><span class="eyebrow"><%= item.category %></span><% if (item.status === 'returned') { %><span class="status-badge returned">Returned</span><% } %></div><h3 class="item-title"><a href="/items/<%= item._id %>"><%= item.title %></a></h3><p class="item-meta mb-2">⌖ <%= item.location %></p><p class="item-description"><%= item.description.length > 100 ? item.description.slice(0,100)+'…' : item.description %></p><div class="card-bottom"><span>Posted by <%= item.owner ? item.owner.name : 'Community member' %></span><a href="/items/<%= item._id %>" class="text-link">View details →</a></div></div></article>
