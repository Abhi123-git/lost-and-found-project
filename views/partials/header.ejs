<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'FindIt — Lost & Found' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top"><div class="container">
  <a class="navbar-brand fw-bold" href="/"><span class="brand-mark">F</span> FindIt<span class="brand-dot">.</span></a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
  <div class="collapse navbar-collapse" id="mainNav"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
    <a class="nav-link" href="/items">Browse items</a>
    <% if (currentUser) { %>
      <a class="nav-link" href="/items/new">Report an item</a><a class="nav-link" href="/dashboard">Dashboard</a>
      <a class="nav-link" href="/notifications">Notifications <% if (unreadCount) { %><span class="count-pill"><%= unreadCount %></span><% } %></a>
      <% if (currentUser.role === 'admin') { %><a class="nav-link" href="/admin">Admin</a><% } %>
      <form action="/logout" method="POST" class="ms-lg-2"><button class="btn btn-outline-dark btn-sm rounded-pill px-3">Log out</button></form>
    <% } else { %><a class="nav-link" href="/login">Log in</a><a class="btn btn-primary btn-sm rounded-pill px-3 ms-lg-2" href="/register">Create account</a><% } %>
  </div></div>
</div></nav>
<main class="page-shell container">
<% if (notice) { %><div class="alert alert-info alert-dismissible fade show mt-3" role="alert"><%= notice %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
