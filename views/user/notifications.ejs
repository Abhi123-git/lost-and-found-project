<%- include('../partials/header', {title:'Notifications — FindIt'}) %><div class="page-heading"><div><span class="eyebrow">UPDATES</span><h1>Notifications</h1><p>Important updates about your reports and messages.</p></div><a href="/dashboard" class="text-link">← Dashboard</a></div><% if(notifications.length){ %><div class="notification-list"><% notifications.forEach(n=>{ %><a href="<%= n.link %>" class="notification-row"><span class="notification-icon">✦</span><span><b><%= n.message %></b><small><%= n.createdAt.toLocaleString('en-IN') %></small></span></a><% }) %></div><% } else { %><div class="empty-state"><h3>You're all caught up</h3><p>There are no notifications right now.</p></div><% } %><%- include('../partials/footer') %>
