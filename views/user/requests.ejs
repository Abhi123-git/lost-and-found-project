<%- include('../partials/header', {title:'Contact requests — FindIt'}) %><div class="page-heading"><div><span class="eyebrow">INCOMING MESSAGES</span><h1>Contact requests</h1><p>People who may have information about your reports.</p></div><a href="/dashboard" class="text-link">← Back to dashboard</a></div><% if(requests.length){ %><div class="request-list"><% requests.forEach(r=>{ %><article class="request-card"><div class="d-flex justify-content-between gap-3"><div><span class="eyebrow"><%= r.item ? r.item.title : 'Item report' %></span><h3><%= r.sender.name %></h3><p class="muted"><%= r.sender.email %> · <%= r.createdAt.toLocaleString('en-IN') %></p></div><span class="status-badge <%= r.status %>"><%= r.status %></span></div><p class="request-message"><%= r.message %></p><% if(r.status==='new'){ %><div class="d-flex gap-2"><form method="POST" action="/requests/<%= r._id %>/status"><input type="hidden" name="status" value="reviewed"><button class="btn btn-primary btn-sm rounded-pill">Mark reviewed</button></form><form method="POST" action="/requests/<%= r._id %>/status"><input type="hidden" name="status" value="closed"><button class="btn btn-outline-dark btn-sm rounded-pill">Close request</button></form></div><% } %></article><% }) %></div><% } else { %><div class="empty-state"><div class="empty-symbol">✉</div><h3>No messages yet</h3><p>New contact requests will appear here.</p></div><% } %><%- include('../partials/footer') %>
