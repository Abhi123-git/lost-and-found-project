<%- include('../partials/header', {title:'My dashboard — FindIt'}) %><section class="page-heading"><div><span class="eyebrow">YOUR FINDIT SPACE</span><h1>Hello, <%= currentUser.name.split(' ')[0] %>.</h1><p>Manage your reports and keep up with people reaching out.</p></div><a href="/items/new" class="btn btn-primary rounded-pill px-4">＋ New report</a></section><div class="dashboard-tabs"><a class="active" href="/dashboard">My reports (<%= items.length %>)</a><a href="/dashboard/requests">Contact requests (<%= requests.length %>)</a></div><div class="row g-3 mb-5"><% if(items.length){ %><% items.forEach(item=>{ %><div class="col-md-6 col-lg-4"><%- include('../partials/item-card',{item:{...item.toObject(),owner:{name:currentUser.name}}}) %><div class="dashboard-item-actions"><a href="/items/<%= item._id %>/edit">Edit</a><a href="/items/<%= item._id %>">Open report</a></div></div><% }) %><% } else { %><div class="empty-state"><div class="empty-symbol">＋</div><h3>Your reports will appear here</h3><p>You haven't posted any items yet.</p><a class="btn btn-primary rounded-pill" href="/items/new">Create your first report</a></div><% } %></div><section class="section-block pt-0"><div class="section-heading"><div><span class="eyebrow">OUTGOING</span><h2>Messages you've sent</h2></div></div><% if(sentRequests.length){ %><div class="table-responsive"><table class="table clean-table"><thead><tr><th>Item</th><th>To</th><th>Message</th><th>Status</th></tr></thead><tbody><% sentRequests.forEach(r=>{ %><tr><td><%= r.item ? r.item.title : 'Deleted item' %></td><td><%= r.recipient ? r.recipient.name : 'User' %></td><td><%= r.message %></td><td><span class="status-badge <%= r.status %>"><%= r.status %></span></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted">You haven't sent any contact requests yet.</p><% } %></section><%- include('../partials/footer') %>
