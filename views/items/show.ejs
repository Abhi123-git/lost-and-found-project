<%- include('../partials/header', {title:item.title+' — FindIt'}) %><div class="detail-layout"><div class="detail-photo"> <% if(item.image) { %><img src="/uploads/<%= item.image %>" alt="<%= item.title %>"><% } else { %><div class="image-placeholder large"><span>⌕</span><small>No photo available</small></div><% } %></div><div class="detail-content"><div class="d-flex gap-2 align-items-center mb-3"><span class="type-badge <%= item.type %>"><%= item.type==='lost'?'Lost item':'Found item' %></span><span class="status-badge <%= item.status %>"><%= item.status==='returned'?'Returned':'Active' %></span></div><span class="eyebrow"><%= item.category %></span><h1><%= item.title %></h1><p class="detail-description"><%= item.description %></p><div class="detail-facts"><div><small>LAST SEEN / FOUND AT</small><b>⌖ <%= item.location %></b></div><div><small>DATE</small><b><%= item.incidentDate.toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %></b></div><div><small>REPORTED BY</small><b><%= item.owner.name %></b></div><div><small>POSTED</small><b><%= item.createdAt.toLocaleDateString('en-IN') %></b></div></div>
<% if(currentUser && (currentUser.id===item.owner._id.toString() || currentUser.role==='admin')) { %><div class="owner-actions"><a class="btn btn-outline-dark rounded-pill" href="/items/<%= item._id %>/edit">Edit report</a><% if(item.status==='active') { %><form method="POST" action="/items/<%= item._id %>/returned"><button class="btn btn-success rounded-pill">Mark as returned</button></form><% } %><form method="POST" action="/items/<%= item._id %>?_method=DELETE" data-confirm="Delete this report permanently?"><button class="btn btn-outline-danger rounded-pill">Delete</button></form></div><% } else if(currentUser && item.status==='active') { %><div class="contact-box"><h3>Think you can help?</h3><p>Send the reporter a message. Your email address is not shown publicly.</p><form method="POST" action="/items/<%= item._id %>/contact" class="form-stack"><textarea name="message" rows="3" minlength="5" maxlength="600" required placeholder="Hi, I think I may have information about this item…"></textarea><button class="btn btn-primary rounded-pill">Send contact request</button></form></div><% } else if(!currentUser && item.status==='active') { %><div class="contact-box"><h3>Have information?</h3><p><a href="/login">Log in</a> to contact the person who reported this item.</p></div><% } %></div></div><%- include('../partials/footer') %>
