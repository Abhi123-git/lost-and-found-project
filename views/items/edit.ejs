<%- include('../partials/header', {title:'Edit report — FindIt'}) %><div class="narrow-page"><span class="eyebrow">UPDATE REPORT</span><h1>Edit item details</h1><div class="form-card mt-4"><form action="/items/<%= item._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="form-stack"><label>Report type<select name="type" required><option value="lost" <%= item.type==='lost'?'selected':'' %>>Lost</option><option value="found" <%= item.type==='found'?'selected':'' %>>Found</option></select></label><label>Item name<input name="title" required maxlength="100" value="<%= item.title %>"></label><label>Category<select name="category" required><% ['Electronics','Documents','Accessories','Clothing','Bags','Keys','Other'].forEach(c=>{ %><option value="<%= c %>" <%= item.category===c?'selected':'' %>><%= c %></option><% }) %></select></label><label>Location<input name="location" required maxlength="120" value="<%= item.location %>"></label><label>Date lost or found<input name="incidentDate" type="date" required value="<%= item.incidentDate.toISOString().slice(0,10) %>"></label><label>Description<textarea name="description" rows="5" required maxlength="1500"><%= item.description %></textarea></label><% if(item.image) { %><img class="edit-preview" src="/uploads/<%= item.image %>" alt="Current item photo"><% } %><label>Replace photo <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif"></label><button class="btn btn-primary rounded-pill">Save changes</button></form></div></div><%- include('../partials/footer') %>
