<%- include('../partials/header', {title:'Report an item — FindIt'}) %><div class="form-page"><div class="form-intro"><span class="eyebrow">MAKE A REPORT</span><h1>Let's get this<br>item noticed.</h1><p>Share accurate details. The more useful your report, the easier it is for someone to recognise the item.</p><div class="tip-card"> <b>Quick tip</b><p>Never publish sensitive information such as passwords, full ID numbers or your home address.</p></div></div><div class="form-card"><h2>Item information</h2><form action="/items" method="POST" enctype="multipart/form-data" class="form-stack"><label>Report type<select name="type" required><option value="">Choose one</option><option value="lost">I lost this item</option><option value="found">I found this item</option></select></label><label>Item name<input name="title" required maxlength="100" placeholder="e.g. Black wireless headphones"></label><label>Category<select name="category" required><option value="">Choose category</option><% ['Electronics','Documents','Accessories','Clothing','Bags','Keys','Other'].forEach(c=>{ %><option><%= c %></option><% }) %></select></label><label>Location<input name="location" required maxlength="120" placeholder="e.g. Central library, first floor"></label><label>Date lost or found<input name="incidentDate" type="date" required max="<%= new Date().toISOString().slice(0,10) %>"></label><label>Description<textarea name="description" rows="5" maxlength="1500" required placeholder="Describe colour, brand, identifying features and other helpful details…"></textarea></label><label>Photo <span class="muted">(optional, JPG/PNG/WEBP/GIF, max 3 MB)</span><input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif"></label><button class="btn btn-primary btn-lg rounded-pill">Publish report</button><a href="/items" class="cancel-link">Cancel</a></form></div></div><%- include('../partials/footer') %>
