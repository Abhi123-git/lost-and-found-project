<%- include('../partials/header', {title:'Browse reports — FindIt'}) %><section class="page-heading"><div><span class="eyebrow">COMMUNITY LISTINGS</span><h1>Browse lost & found</h1><p>Search recent reports and help make a connection.</p></div><% if (currentUser) { %><a class="btn btn-primary rounded-pill px-4" href="/items/new">＋ Report an item</a><% } %></section><form class="filter-bar" method="GET" action="/items"><input name="q" value="<%= filters.q || '' %>" placeholder="Search item, details or location…"><select name="type"><option value="">All reports</option><option value="lost" <%= filters.type==='lost'?'selected':'' %>>Lost</option><option value="found" <%= filters.type==='found'?'selected':'' %>>Found</option></select><select name="category"><option value="">All categories</option><% ['Electronics','Documents','Accessories','Clothing','Bags','Keys','Other'].forEach(c => { %><option value="<%= c %>" <%= filters.category===c?'selected':'' %>><%= c %></option><% }) %></select><select name="status"><option value="active" <%= filters.status!=='returned'?'selected':'' %>>Active</option><option value="returned" <%= filters.status==='returned'?'selected':'' %>>Returned</option></select><button class="btn btn-primary rounded-pill px-4">Search</button></form><div class="d-flex justify-content-between align-items-center mb-3"><span class="muted"><%= items.length %> report(s) found</span><a href="/items" class="text-link">Clear filters</a></div><div class="row g-4"> <% if(items.length) { %><% items.forEach(item => { %><div class="col-md-6 col-lg-4"><%- include('../partials/item-card',{item}) %></div><% }) %><% } else { %><div class="empty-state"><div class="empty-symbol">⌕</div><h3>No matching reports</h3><p>Try a different keyword or clear your filters.</p></div><% } %></div><%- include('../partials/footer') %>
